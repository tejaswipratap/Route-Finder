<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-road text-success me-2"></i>Road Management</h2>
            <p class="text-muted small mb-0">Add, update distances, or delete weighted edges connecting cities.</p>
        </div>
        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addRoadModal">
            <i class="fa-solid fa-plus me-1"></i> Add New Road
        </button>
    </div>

    <div class="card glass-card p-4">
        <div class="table-responsive">
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Source City</th>
                        <th>Destination City</th>
                        <th>Distance (KM)</th>
                        <th>Road Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (roads && roads.length > 0) { %>
                        <% roads.forEach((road, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td><strong class="text-info"><%= road.source ? road.source.name : 'Unknown' %></strong></td>
                                <td><strong class="text-info"><%= road.destination ? road.destination.name : 'Unknown' %></strong></td>
                                <td><span class="badge bg-warning text-dark fs-6"><%= road.distance %> KM</span></td>
                                <td><span class="badge bg-secondary"><%= road.roadType %></span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteRoad('<%= road._id %>')">
                                        <i class="fa-solid fa-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="6" class="text-muted text-center py-3">No roads found</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Road Modal -->
<div class="modal fade" id="addRoadModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus text-success me-2"></i>Add Road</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="addRoadForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Source City</label>
                        <select class="form-select bg-dark text-light border-secondary" id="roadSource" required>
                            <option value="">-- Select Source --</option>
                            <% cities.forEach(city => { %>
                                <option value="<%= city._id %>"><%= city.name %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Destination City</label>
                        <select class="form-select bg-dark text-light border-secondary" id="roadDestination" required>
                            <option value="">-- Select Destination --</option>
                            <% cities.forEach(city => { %>
                                <option value="<%= city._id %>"><%= city.name %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Distance in KM</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" id="roadDistance" required min="1" placeholder="e.g. 250">
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-muted">Road Category</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary" id="roadType" value="National Highway">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold">Save Road</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
